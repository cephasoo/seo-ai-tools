# Ignore API Key and token storage files
config.py

# Ignore Python bytecode files
__pycache__/
*.pyc

# Ignore the Python virtual environment folder
.venv/

# Ignore any sensitive environment files
.env
.env.*
!.env.example

# --- CORRECTED CUSTOM MODEL EXCLUSIONS ---
